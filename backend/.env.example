# Backend Server Port
PORT=5000

# Allowed CORS Origins (comma-separated for multiple domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://aparichat.app,https://www.aparichat.app,https://aparichat.vercel.app,https://stranger-meet-two.vercel.app

# Firebase Admin Service Account (For Cloud/Production Deployments like Render)
# Paste the full content of serviceAccountKey.json as a single-line JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# WebRTC TURN Configuration
# Option A: OpenRelay / Standard TURN credentials (default fallback)
TURN_USERNAME=openrelayproject
TURN_PASSWORD=openrelayproject
# TURN_URL=turn:openrelay.metered.ca:80

# Option B: Metered.ca Dynamic Ephemeral Credentials REST API (Recommended for production)
# METERED_API_KEY=your_metered_api_key
# METERED_APP_NAME=your_app_name

# Option C: Coturn Ephemeral HMAC Shared Secret Token
# COTURN_SECRET=your_coturn_static_auth_secret
# COTURN_URLS=turn:turn.aparichat.app:3478?transport=udp,turn:turn.aparichat.app:3478?transport=tcp,turns:turn.aparichat.app:443?transport=tcp
