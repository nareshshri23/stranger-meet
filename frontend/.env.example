# Firebase Web App Configuration (Found in Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Backend Signaling Server URL (Defaults to https://stranger-meet-api.onrender.com if not specified)
VITE_BACKEND_URL=https://stranger-meet-api.onrender.com

# WebRTC TURN Server Configuration
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_PASSWORD=openrelayproject
